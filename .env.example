# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration
# Set DB_DIALECT to 'mysql' (default for localhost) or 'postgres' for Supabase
DB_DIALECT="mysql"

# For MySQL (XAMPP/phpMyAdmin)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="ris_db"
DB_USER="root"
DB_PASSWORD=""

# For PostgreSQL (Supabase)
# DB_DIALECT="postgres"
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# DB_SSL="true"

# Supabase Client Configuration
VITE_SUPABASE_URL=https://oqwsvphkszyscwleeahk.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_HambAVsBcFxEGFv64vPEOA_VoHPeltP
